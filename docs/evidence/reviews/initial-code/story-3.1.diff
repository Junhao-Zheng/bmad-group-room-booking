+                               for u,d,r in DEMO_IDENTITIES], FixedClock())
+        seed_history_fixture(cls.fixture)
+
+    @classmethod
+    def tearDownClass(cls): cls.directory.cleanup()
+
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory(); self.addCleanup(directory.cleanup)
