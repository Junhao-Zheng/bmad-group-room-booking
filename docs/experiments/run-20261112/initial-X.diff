+def fingerprints():
+    files = list((ROOT / 'booking_app').rglob('*')) + [Path(__file__), ROOT / 'scripts/verify_availability_performance.py', ROOT / 'scripts/verify_history_browser.py']
+    return {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(files)
+            if p.is_file() and p.suffix in {'.py', '.sql', '.js', '.html', '.css'}}
